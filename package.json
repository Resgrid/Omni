{
  "name": "resgrid-omni",
  "private": true,
  "description": "Resgrid Omni — one Expo codebase building the Responder, Unit, IC, Dispatch and BigBoard apps for iOS, Android, web and Electron.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resgrid/Omni.git"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.5.0"
  },
  "scripts": {
    "start": "pnpm --filter @resgrid/omni start",
    "ios:responder": "node scripts/run-native.mjs ios responder",
    "ios:unit": "node scripts/run-native.mjs ios unit",
    "ios:ic": "node scripts/run-native.mjs ios ic",
    "ios:dispatch": "node scripts/run-native.mjs ios dispatch",
    "ios:bigboard": "node scripts/run-native.mjs ios bigboard",
    "android:responder": "node scripts/run-native.mjs android responder",
    "android:unit": "node scripts/run-native.mjs android unit",
    "android:ic": "node scripts/run-native.mjs android ic",
    "android:dispatch": "node scripts/run-native.mjs android dispatch",
    "android:bigboard": "node scripts/run-native.mjs android bigboard",
    "web:responder": "node scripts/run-web.mjs responder",
    "web:unit": "node scripts/run-web.mjs unit",
    "web:ic": "node scripts/run-web.mjs ic",
    "web:dispatch": "node scripts/run-web.mjs dispatch",
    "web:bigboard": "node scripts/run-web.mjs bigboard",
    "desktop:mac": "node scripts/build-desktop.mjs mac",
    "desktop:linux": "node scripts/build-desktop.mjs linux",
    "desktop:windows": "node scripts/build-desktop.mjs windows",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "lint:anti-slop": "node scripts/ci/anti-slop.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css}\"",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "deps:check": "depcruise packages apps --config .dependency-cruiser.cjs",
    "variants:check": "tsx scripts/variants-check.ts",
    "eas:generate": "node scripts/generate-eas-json.mjs",
    "check-all": "node scripts/check-all.mjs",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "prepare": "lefthook install || true",
    "eas:check": "node scripts/generate-eas-json.mjs --check",
    "ios:adhoc": "node scripts/build-ios-adhoc.mjs",
    "credentials:android": "node scripts/eas-credentials.mjs android",
    "credentials:ios": "node scripts/eas-credentials.mjs ios",
    "credentials:ios-adhoc": "node scripts/eas-credentials.mjs ios-adhoc",
    "setup:app-distribution": "node scripts/setup-app-distribution.mjs",
    "e2e:web": "playwright test -c apps/omni/e2e/playwright.config.ts",
    "qa:regression": "tsx apps/omni/e2e/qa-regression.ts",
    "qa:responder": "tsx apps/omni/e2e/qa-regression.ts responder",
    "qa:unit": "tsx apps/omni/e2e/qa-regression.ts unit",
    "qa:ic": "tsx apps/omni/e2e/qa-regression.ts ic",
    "qa:dispatch": "tsx apps/omni/e2e/qa-regression.ts dispatch",
    "qa:bigboard": "tsx apps/omni/e2e/qa-regression.ts bigboard",
    "qa:stack": "node scripts/qa-stack.mjs",
    "workflows:check": "node scripts/ci/validate-workflows.mjs"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-dynamic-import": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/compat": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@playwright/test": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "jest": "catalog:",
    "jest-junit": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "dependencies": {
    "@resgrid/config": "workspace:*",
    "@resgrid/config-plugins": "workspace:*",
    "@resgrid/core": "workspace:*",
    "@resgrid/models": "workspace:*",
    "@resgrid/api": "workspace:*",
    "@resgrid/offline": "workspace:*",
    "@resgrid/auth": "workspace:*",
    "@resgrid/data": "workspace:*",
    "@resgrid/realtime": "workspace:*",
    "@resgrid/notifications": "workspace:*",
    "@resgrid/location": "workspace:*",
    "@resgrid/voice": "workspace:*",
    "@resgrid/maps": "workspace:*",
    "@resgrid/navigation": "workspace:*",
    "@resgrid/i18n": "workspace:*",
    "@resgrid/ui": "workspace:*",
    "@resgrid/app-shell": "workspace:*",
    "@resgrid/features": "workspace:*",
    "expo": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "version": "1.0.0"
}
