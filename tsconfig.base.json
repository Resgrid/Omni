{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "types": ["jest", "node"],
    "paths": {
      "@resgrid/config": ["./packages/config/src/index.ts"],
      "@resgrid/config/*": ["./packages/config/src/*"],
      "@resgrid/core": ["./packages/core/src/index.ts"],
      "@resgrid/core/*": ["./packages/core/src/*"],
      "@resgrid/models": ["./packages/models/src/index.ts"],
      "@resgrid/models/*": ["./packages/models/src/*"],
      "@resgrid/api": ["./packages/api/src/index.ts"],
      "@resgrid/api/*": ["./packages/api/src/*"],
      "@resgrid/offline": ["./packages/offline/src/index.ts"],
      "@resgrid/offline/*": ["./packages/offline/src/*"],
      "@resgrid/auth": ["./packages/auth/src/index.ts"],
      "@resgrid/auth/*": ["./packages/auth/src/*"],
      "@resgrid/data": ["./packages/data/src/index.ts"],
      "@resgrid/data/*": ["./packages/data/src/*"],
      "@resgrid/realtime": ["./packages/realtime/src/index.ts"],
      "@resgrid/realtime/*": ["./packages/realtime/src/*"],
      "@resgrid/notifications": ["./packages/notifications/src/index.ts"],
      "@resgrid/notifications/*": ["./packages/notifications/src/*"],
      "@resgrid/location": ["./packages/location/src/index.ts"],
      "@resgrid/location/*": ["./packages/location/src/*"],
      "@resgrid/voice": ["./packages/voice/src/index.ts"],
      "@resgrid/voice/*": ["./packages/voice/src/*"],
      "@resgrid/maps": ["./packages/maps/src/index.ts"],
      "@resgrid/maps/*": ["./packages/maps/src/*"],
      "@resgrid/navigation": ["./packages/navigation/src/index.ts"],
      "@resgrid/navigation/*": ["./packages/navigation/src/*"],
      "@resgrid/i18n": ["./packages/i18n/src/index.ts"],
      "@resgrid/i18n/*": ["./packages/i18n/src/*"],
      "@resgrid/ui": ["./packages/ui/src/index.ts"],
      "@resgrid/ui/*": ["./packages/ui/src/*"],
      "@resgrid/app-shell": ["./packages/app-shell/src/index.ts"],
      "@resgrid/app-shell/*": ["./packages/app-shell/src/*"],
      "@resgrid/features": ["./packages/features/src/index.ts"],
      "@resgrid/features/*": ["./packages/features/src/*"]
    }
  }
}
